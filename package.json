{
  "name": "focusflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p cli/tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cli:build": "esbuild cli/focusflow.ts --bundle --platform=node --format=esm '--alias:$lib=./src/lib' --outfile=dist-cli/focusflow.mjs --banner:js='#!/usr/bin/env node'",
    "cli": "node dist-cli/focusflow.mjs",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "test": "vitest run && TZ=Asia/Shanghai vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "bin": {
    "focusflow": "./dist-cli/focusflow.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/cli-darwin-arm64": "^2.11.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
